<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/void_background">

    <com.example.localtoycloud.GyroscopeView
        android:id="@+id/gyroscopeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="bottom">

            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/promptOutputTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/cyber_bubble"
                        android:padding="16dp"
                        android:text="Void space initialized. Awaiting user input for local MediaPipe expansion..."
                        android:textColor="#E0F7FA"
                        android:textSize="15sp"
                        android:shadowColor="#8000F0FF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="8" />

                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cyber_bubble"
                android:padding="12dp"
                android:layout_marginTop="12dp">

                <EditText
                    android:id="@+id/inputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Enter concept into the void..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="16sp"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:padding="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/generatePromptButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/cyber_bubble"
                        android:text="Local LLM"
                        android:textColor="#00F0FF"
                        android:textSize="12sp"
                        android:textAllCaps="false"/>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/sendToCloudButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/cyber_bubble"
                        android:text="Cloud Gemini"
                        android:textColor="#FF007F"
                        android:textSize="12sp"
                        android:textAllCaps="false"/>

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.example.localtoycloud.GyroscopeView>

</FrameLayout>        android:id="@+id/generatePromptButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Run Local LLM Prompt Expansion"
        app:layout_constraintTop_toBottomOf="@id/inputEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/promptOutputLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Optimized Local Prompt:"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/generatePromptButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="@android:drawable/dialog_holo_light_frame"
        app:layout_constraintTop_toBottomOf="@id/promptOutputLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/promptOutputTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Local prompt output will appear here..."
            android:padding="8dp"
            android:textColor="@android:color/black"/>
    </ScrollView>

    <Button
        android:id="@+id/sendToCloudButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Send to Cloud (Gemini API)"
        app:layout_constraintTop_toBottomOf="@id/scrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
